// People page: server-side search + paging (infinite scroll). Reads under the caller's own rules, like rpt.employeeDirectory.
// $term matches name, job title, employee number and work email; Turkish letters are folded (translate) on both sides.
// Paging: with parameters `TAKE $a..$b` compiles to OFFSET $a LIMIT $b (a count), unlike literals where b is an end position (finding).
DEFINE OR REPLACE public hr.directoryPage displayName: 'People directory (page)' AS
  SELECT hr.employees {
    employeeId := _id, userId := person._id, name := person.name, picture := person.picture, employeeNumber, jobTitle,
    department, office, manager, status, workEmail := person.emails[max(email) FILTER primary == true]
  } FILTER ($departmentTeamId(type: uuid)::uuid IS NULL OR department == $departmentTeamId::uuid)
    AND ($officeTeamId(type: uuid)::uuid IS NULL OR currentOffice == $officeTeamId::uuid)
    AND ($status(type: string)::text IS NULL OR status == $status::text)
    AND ($term(type: string)::text IS NULL
      OR translate(person.name, 'ŞÇĞİÖÜşçğıöüÂÎÛâîû', 'SCGIOUscgiouAIUaiu') ILIKE '%' || translate($term::text, 'ŞÇĞİÖÜşçğıöüÂÎÛâîû', 'SCGIOUscgiouAIUaiu') || '%'
      OR translate(jobTitle, 'ŞÇĞİÖÜşçğıöüÂÎÛâîû', 'SCGIOUscgiouAIUaiu') ILIKE '%' || translate($term::text, 'ŞÇĞİÖÜşçğıöüÂÎÛâîû', 'SCGIOUscgiouAIUaiu') || '%'
      OR employeeNumber ILIKE '%' || $term::text || '%'
      OR person.emails HAS (email ILIKE '%' || $term::text || '%'))
  SORT name, employeeNumber
  TAKE $offset(type: integer, required)..$limit(type: integer, required)
END;

DEFINE OR REPLACE public hr.directoryCount displayName: 'People directory (count)' AS
  SUMMARIZE hr.employees { total := count(*) }
  FILTER ($departmentTeamId(type: uuid)::uuid IS NULL OR department == $departmentTeamId::uuid)
    AND ($officeTeamId(type: uuid)::uuid IS NULL OR currentOffice == $officeTeamId::uuid)
    AND ($status(type: string)::text IS NULL OR status == $status::text)
    AND ($term(type: string)::text IS NULL
      OR translate(person.name, 'ŞÇĞİÖÜşçğıöüÂÎÛâîû', 'SCGIOUscgiouAIUaiu') ILIKE '%' || translate($term::text, 'ŞÇĞİÖÜşçğıöüÂÎÛâîû', 'SCGIOUscgiouAIUaiu') || '%'
      OR translate(jobTitle, 'ŞÇĞİÖÜşçğıöüÂÎÛâîû', 'SCGIOUscgiouAIUaiu') ILIKE '%' || translate($term::text, 'ŞÇĞİÖÜşçğıöüÂÎÛâîû', 'SCGIOUscgiouAIUaiu') || '%'
      OR employeeNumber ILIKE '%' || $term::text || '%'
      OR person.emails HAS (email ILIKE '%' || $term::text || '%'))
END
