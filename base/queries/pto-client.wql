// Task 15: reads for the Time Off screens
DEFINE OR REPLACE public pto.listTypes displayName: 'Time off types' AS
  SELECT pto.types { typeId := _id, code, name, category, paid, color, active } SORT +name
END

// open approval requests the caller may see (system.interactions is filtered by the answer rules)
DEFINE OR REPLACE public pto.myApprovals displayName: 'Time off requests waiting for me' AS
  SELECT system.interactions { interactionId := _id, name, description, params, status, _createdAt }
  FILTER stepKey == 'pto.requestApproval.ask' AND status != 'completed' SORT -_createdAt
END

// Workaround (see findings): pto.workingHours is refused when an employee calls it directly
// ("ds of hol does not allow filtering"), so the client previews its own hours through this elevated copy.
DEFINE OR REPLACE elevated public pto.previewHours displayName: 'Preview my working hours' AS
  $emp := SELECT hr.employees { off := currentOffice._id, et := employmentType } FILTER person == $context.userId::uuid TAKE 1;
  $cs := SELECT org.units { c := btrim(country::text, '"') } FILTER team == $emp.off TAKE 1;
  $set := SELECT org.country_settings { wd := weekendDays } FILTER btrim(country::text, '"') == $cs.c TAKE 1;
  $pol := SELECT pto.policies { hpd := hoursPerDay } FILTER type.code == coalesce($typeCode(type: string)::text, 'VAC') AND country == $cs.c AND employmentType == $emp.et TAKE 1;
  $hol := SUMMARIZE pto.holidays { ds := array_agg(date) } FILTER btrim(country::text, '"') == $cs.c AND status == 'active' AND date BETWEEN $startDate(type: date, required) AND $endDate(type: date, required);
  SELECT pto.seq {
    date := ($startDate + make_interval(0, 0, 0, n))::date,
    hours := coalesce(jsonb_extract_path_text($partial(type: jsonb), (($startDate + make_interval(0, 0, 0, n))::date)::text)::numeric, coalesce($pol.hpd, 8))
  } FILTER $emp.off IS NOT NULL AND n <= ($endDate - $startDate) AND n <= 120
    AND NOT (date_part('isodow', ($startDate + make_interval(0, 0, 0, n))::date)::int == ANY(coalesce($set.wd, ARRAY[6, 7])))
    AND NOT (($startDate + make_interval(0, 0, 0, n))::date == ANY(coalesce($hol.ds, ARRAY[]::date[])))
  SORT n
END
