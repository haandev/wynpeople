DEFINE OR REPLACE elevated public hr.sendSetPasswordLink AS
  $e := SELECT hr.employees { _id, off := currentOffice._id } FILTER person == $userId(type: uuid, required) TAKE 1;
  ASSERT $context.userId IS NULL OR $e.off IN $context.teamIdsLed code: 'OUT_OF_SCOPE', message: 'You can only invite employees of an office you manage', status: 403;
  $address := SELECT auth.emails { _id, email } FILTER user == $userId AND primary == true TAKE 1;
  ASSERT $address._id != NULL code: 'NO_PRIMARY_EMAIL', message: 'The account has no primary email address', status: 404;
  $r := job.sendEmail(
    message: 'account.password_enroll',
    to: $address.email,
    links: jsonb_build_object('setPasswordUrl', jsonb_build_object('path', '/set-password', 'params', jsonb_build_object('identifier', $address.email),
      'token', jsonb_build_object('purpose', 'password_enroll', 'userId', $userId::text, 'emailId', $address._id, 'param', 'token')))
  );
  ASSERT ($r.reason ?? '') != 'rate-limited' code: 'RATE_LIMITED', message: 'Too many messages were queued just now. Try again in a minute.', status: 429;
  ASSERT $r.queued code: 'MAIL_NOT_QUEUED', message: 'This base cannot send email right now, so the set-password link was not sent.', status: 503;
  SELECT { queued := $r.queued }
END
