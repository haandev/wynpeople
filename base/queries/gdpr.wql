// GDPR tooling (Task 11)
DEFINE OR REPLACE elevated public gdpr.subjectAccessExport displayName: 'Subject access export', audit: 'arguments' AS
  $e := SELECT hr.employees { _id, uid := person._id, off := currentOffice._id } FILTER _id == $employeeId(type: uuid, required) TAKE 1;
  ASSERT $e._id != NULL code: 'NOT_FOUND', message: 'No such employee', status: 404;
  ASSERT 'hr_admin' IN $context.role OR ('hr_manager' IN $context.role AND $e.off IN $context.teamIdsLed) code: 'OUT_OF_SCOPE', message: 'Only HR for this employee can export their data', status: 403;
  $comp := SUMMARIZE EFFECTIVE ALL hr.compensation { rows := coalesce(jsonb_agg(jsonb_build_object('payRate', payRate, 'currency', currency, 'payType', payType, 'payPeriod', payPeriod, 'changeReason', changeReason, 'effectiveFrom', _effectiveFrom, 'effectiveTo', _effectiveTo)), '[]'::jsonb) } FILTER employee == $e._id;
  SELECT hr.employees {
    employeeId := _id, employeeNumber, hireDate,
    profile := (SELECT person { _id, username, name, givenName, familyName, middleName, nickname, pronouns, locale, zoneinfo, _createdAt }),
    jobTitle := (SELECT EFFECTIVE ALL jobTitle { value, reason, _effectiveFrom, _effectiveTo }),
    department := (SELECT EFFECTIVE ALL department { value, reason, _effectiveFrom, _effectiveTo }),
    office := (SELECT EFFECTIVE ALL office { value, reason, _effectiveFrom, _effectiveTo }),
    manager := (SELECT EFFECTIVE ALL manager { value, reason, _effectiveFrom, _effectiveTo }),
    status := (SELECT EFFECTIVE ALL status { value, reason, _effectiveFrom, _effectiveTo }),
    employmentType := (SELECT EFFECTIVE ALL employmentType { value, reason, _effectiveFrom, _effectiveTo }),
    terminationReason := (SELECT EFFECTIVE ALL terminationReason { value, reason, _effectiveFrom, _effectiveTo }),
    emails := (SELECT auth.emails { email, primary, _createdAt } FILTER user == $e.uid),
    phones := (SELECT auth.phone_numbers { * } FILTER user == $e.uid),
    addresses := (SELECT auth.addresses { * } FILTER user == $e.uid),
    emergencyContacts := (SELECT hr.emergency_contacts { * } FILTER employee == $e._id),
    education := (SELECT hr.education { institution, degree, major, gpa, startDate, endDate, _createdAt } FILTER employee == $e._id),
    compensation := $comp.rows,
    ptoRequests := (SELECT pto.requests { type := type.name, startDate, endDate, totalHours, status, note, decidedBy, decidedAt, decisionNote } FILTER employee == $e._id),
    ptoLedger := (SELECT pto.ledger { type := type.name, kind, hours, entryDate, reason } FILTER employee == $e._id),
    exports := (SELECT rpt.export_events { report, format, filters, rowCount, _createdAt } FILTER _createdBy == $e.uid),
    accessLogs := (SELECT system.invocations { nodeId, kind, outcome, origin, arguments, _createdAt } FILTER user == $e.uid SORT -_createdAt TAKE 1000)
  } FILTER _id == $e._id
END

DEFINE OR REPLACE public gdpr.saveRetentionPolicy displayName: 'Save retention policy', audit: 'arguments' AS
  UPSERT gdpr.retention_policies [country == $country(type: string, required)] { country: $country, retainYearsAfterTermination: $years(type: int, required) } -> { _id, country, retainYearsAfterTermination }
END

DEFINE OR REPLACE elevated public gdpr.retentionCandidates displayName: 'Employees past retention', audit: 'arguments' AS
  $om := SUMMARIZE org.units { m := jsonb_object_agg(team._id::text, btrim(country::text, '"')) } FILTER kind == 'office';
  $pol := SUMMARIZE gdpr.retention_policies { m := jsonb_object_agg(country, retainYearsAfterTermination) };
  SELECT hr.employees { employeeId := _id, employeeNumber, name := person.name, terminationDate, country := jsonb_extract_path_text($om.m, currentOffice._id::text), retainYears := jsonb_extract_path_text($pol.m, jsonb_extract_path_text($om.m, currentOffice._id::text))::int }
  FILTER status == 'terminated' AND anonymizedAt IS NULL AND terminationDate IS NOT NULL
    AND jsonb_extract_path_text($pol.m, jsonb_extract_path_text($om.m, currentOffice._id::text)) IS NOT NULL
    AND terminationDate + make_interval(jsonb_extract_path_text($pol.m, jsonb_extract_path_text($om.m, currentOffice._id::text))::int) < coalesce($asOf(type: date)::date, current_date)
END

DEFINE OR REPLACE elevated public gdpr.anonymize displayName: 'Anonymize former employee', audit: 'arguments' AS
  $e := SELECT hr.employees { _id, uid := person._id, num := employeeNumber, st := status, an := anonymizedAt } FILTER _id == $employeeId(type: uuid, required) TAKE 1;
  ASSERT $e._id != NULL code: 'NOT_FOUND', message: 'No such employee', status: 404;
  ASSERT $e.st == 'terminated' code: 'NOT_TERMINATED', message: 'Only terminated employees can be anonymized', status: 409;
  ASSERT $e.an IS NULL code: 'ALREADY_ANONYMIZED', message: 'This employee is already anonymized', status: 409;
  DELETE auth.addresses [user == $e.uid];
  DELETE auth.phone_numbers [user == $e.uid];
  DELETE auth.emails [user == $e.uid AND primary == false];
  DELETE hr.emergency_contacts [employee == $e._id];
  DELETE hr.education [employee == $e._id];
  DELETE EFFECTIVE ALL hr.compensation [employee == $e._id];
  // Review fix: usernames and work emails carry the person's name, so they are replaced too; free-text notes are cleared.
  UPDATE auth.emails [user == $e.uid AND primary == true] { email: 'former-' || lower(coalesce($e.num, $e._id::text)) || '@anonymized.invalid' };
  UPDATE auth.users [_id == $e.uid] { name: 'Former employee ' || coalesce($e.num, ''), username: 'former-' || lower(coalesce($e.num, $e._id::text)), givenName: NULL, familyName: NULL, middleName: NULL, nickname: NULL, pronouns: NULL, picture: NULL, deactivatedAt: coalesce(deactivatedAt, now()) };
  UPDATE pto.requests [employee == $e._id] { note: NULL, decisionNote: NULL };
  UPDATE HARD hr.employees [_id == $e._id] { anonymizedAt: now(), terminationNote: NULL } -> { _id, anonymizedAt }
END
