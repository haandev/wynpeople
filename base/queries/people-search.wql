// Type-ahead person search for pickers (vekil, yönetici, işe alımda yönetici). Reads under the caller's own rules.
// Returns at most 20 rows; a chosen person is looked up by userId so the picker can show the name.
DEFINE OR REPLACE public hr.searchPeople displayName: 'Search people' AS
  SELECT hr.employees {
    employeeId := _id, userId := person._id, name := person.name, jobTitle, office, employeeNumber,
    picture := person.picture, status
  } FILTER ($userId(type: uuid)::uuid IS NOT NULL AND person == $userId::uuid)
    OR ($userId::uuid IS NULL
      AND ($includeTerminated(type: boolean) == true OR status != 'terminated')
      AND (person.name ILIKE '%' || coalesce($term(type: string)::text, '') || '%'
        OR employeeNumber ILIKE '%' || coalesce($term::text, '') || '%'
        OR jobTitle ILIKE '%' || coalesce($term::text, '') || '%'))
  SORT name
  TAKE 20
END
