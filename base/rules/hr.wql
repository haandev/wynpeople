// hr.employees — directory readable by every signed-in person
GRANT read ON hr.employees TO ALL FILTER NOT guest();
// job/status history (effective periods): HR, office HR manager, self and direct manager
GRANT readEffective ON hr.employees TO hr_admin;
GRANT readEffective ON hr.employees TO hr_manager FILTER leads(currentOffice);
GRANT readEffective ON hr.employees TO ALL FILTER self(person) OR self(currentManager);
// termination details: HR only (cell rules)
GRANT read ON hr.employees.terminationReason TO hr_admin;
GRANT read ON hr.employees.terminationReason TO hr_manager FILTER leads(currentOffice);
GRANT read ON hr.employees.terminationType TO hr_admin;
GRANT read ON hr.employees.terminationType TO hr_manager FILTER leads(currentOffice);
GRANT read ON hr.employees.terminationNote TO hr_admin;
GRANT read ON hr.employees.terminationNote TO hr_manager FILTER leads(currentOffice);
// compensation: HR (admins all, managers their offices), and every employee their own pay (WDB-4327). Nobody else:
// a line manager does not see their reports' pay.
GRANT read ON hr.compensation TO ALL FILTER self(employee.person);
GRANT readEffective ON hr.compensation TO ALL FILTER self(employee.person);
GRANT read ON hr.compensation TO hr_admin;
GRANT read ON hr.compensation TO hr_manager FILTER leads(employee.currentOffice);
GRANT readEffective ON hr.compensation TO hr_admin;
GRANT readEffective ON hr.compensation TO hr_manager FILTER leads(employee.currentOffice);
// emergency contacts: self manages, HR and manager read
GRANT read ON hr.emergency_contacts TO ALL FILTER self(employee.person) OR self(employee.currentManager);
GRANT insert ON hr.emergency_contacts TO ALL FILTER self(employee.person);
GRANT delete ON hr.emergency_contacts TO ALL FILTER self(employee.person);
GRANT read ON hr.emergency_contacts TO hr_admin;
GRANT read ON hr.emergency_contacts TO hr_manager FILTER leads(employee.currentOffice);
// Added in Task 5 after security tests found leaks
PREVENT readEffective ON hr.employees EXCEPT hr_admin FILTER NOT (self(person) OR self(currentManager) OR leads(currentOffice));
PREVENT read ON hr.employees.terminationReason EXCEPT hr_admin FILTER NOT leads(currentOffice);
PREVENT read ON hr.employees.terminationType EXCEPT hr_admin FILTER NOT leads(currentOffice);
PREVENT read ON hr.employees.terminationNote EXCEPT hr_admin FILTER NOT leads(currentOffice);
// history of effective columns: hide non-current periods outside self / manager / office lead (one per managed table:
// jobTitle department productTeam office manager costCenter legalEntity status employmentType workerType leaveType)
PREVENT read ON hr.employees_<col> EXCEPT hr_admin FILTER (_effectiveFrom > current_date OR (_effectiveTo IS NOT NULL AND _effectiveTo <= current_date)) AND NOT (self(owner.person) OR self(owner.currentManager) OR leads(owner.currentOffice));
// Final review fix (Critical 2): leave type only to self / manager / HR; status and leave reasons only to HR
PREVENT read ON hr.employees.leaveType EXCEPT hr_admin FILTER NOT (self(person) OR self(currentManager) OR leads(currentOffice));
PREVENT read ON hr.employees_leaveType EXCEPT hr_admin FILTER NOT (self(owner.person) OR self(owner.currentManager) OR leads(owner.currentOffice));
PREVENT read ON hr.employees_status.reason EXCEPT hr_admin FILTER NOT leads(owner.currentOffice);
PREVENT read ON hr.employees_leaveType.reason EXCEPT hr_admin FILTER NOT leads(owner.currentOffice);

// Documents upload (storage.attach) needs row-level update on hr.employees; granted 2026-11-20 with user approval.
GRANT update ON hr.employees TO hr_manager FILTER leads(currentOffice);
GRANT update ON hr.employees TO hr_admin FILTER leads(currentOffice);
// Nobody writes their own employee row directly (same as the OWN_RECORD asserts).
PREVENT update ON hr.employees TO ALL FILTER self(person);

// education: the person keeps their own; their manager reads it; HR reads and keeps it (admins everywhere, HR managers their offices)
GRANT read ON hr.education TO ALL FILTER self(employee.person) OR self(employee.currentManager);
GRANT insert ON hr.education TO ALL FILTER self(employee.person);
GRANT update ON hr.education TO ALL FILTER self(employee.person);
GRANT delete ON hr.education TO ALL FILTER self(employee.person);
GRANT read ON hr.education TO hr_admin;
GRANT insert ON hr.education TO hr_admin;
GRANT update ON hr.education TO hr_admin;
GRANT delete ON hr.education TO hr_admin;
GRANT read ON hr.education TO hr_manager FILTER leads(employee.currentOffice);
GRANT insert ON hr.education TO hr_manager FILTER leads(employee.currentOffice);
GRANT update ON hr.education TO hr_manager FILTER leads(employee.currentOffice);
GRANT delete ON hr.education TO hr_manager FILTER leads(employee.currentOffice);
