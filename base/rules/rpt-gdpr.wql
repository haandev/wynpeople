// rpt.export_events: anyone signed in may log an export; HR reads; immutable
GRANT insert ON rpt.export_events TO ALL FILTER NOT guest();
GRANT read ON rpt.export_events TO hr_admin;
GRANT read ON rpt.export_events TO hr_manager;
PREVENT update ON rpt.export_events;
PREVENT delete ON rpt.export_events;
// gdpr.retention_policies
GRANT read ON gdpr.retention_policies TO hr_admin;
GRANT read ON gdpr.retention_policies TO hr_manager;
GRANT insert ON gdpr.retention_policies TO hr_admin;
GRANT update ON gdpr.retention_policies TO hr_admin;
// elevated NQs
GRANT call ON rpt.auditLog TO hr_admin;
GRANT call ON gdpr.subjectAccessExport TO hr_admin;
GRANT call ON gdpr.subjectAccessExport TO hr_manager;
GRANT call ON gdpr.retentionCandidates TO hr_admin;
GRANT call ON gdpr.anonymize TO hr_admin;
// retention review flow
GRANT answer ON gdpr.retentionReview.ask TO hr_admin;
// Task 15
GRANT call ON pto.previewHours TO employee;
GRANT call ON pto.previewHours TO hr_manager;
GRANT call ON pto.previewHours TO hr_admin;
// Task 17
GRANT call ON hr.listAccounts TO hr_admin;
GRANT call ON hr.listUserRoles TO hr_admin;
GRANT call ON pto.previewRecalc TO hr_admin;
GRANT call ON pto.previewRecalc TO hr_manager;
// Availability
GRANT call ON pto.availability TO employee;
GRANT call ON pto.availability TO hr_manager;
GRANT call ON pto.availability TO hr_admin;
// Final review fix: reopen a stuck recalculation
GRANT call ON pto.reopenRecalc TO hr_admin;
GRANT call ON pto.reopenRecalc TO hr_manager;
